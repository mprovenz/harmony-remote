<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>HarmonyRemote.App</RootNamespace>
    <AssemblyName>harmony-remote</AssemblyName>
    <Version>0.1.0</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon />
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- D-Bus for the Background portal; same version Avalonia.FreeDesktop 12.1.4 uses. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../HarmonyRemote.Core/HarmonyRemote.Core.csproj" />
  </ItemGroup>
</Project>
